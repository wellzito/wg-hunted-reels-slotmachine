  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "O PigSpin \xE9 ativado quando a barra EvilPot \xE9 preenchida totalmente.
    Evil \xE9 o s\xEDmbolo que carrega a barra.\n\nUm novo s\xEDmbolo, Pig, \xE9
    adicionado ao rodilho e o jogador recebe 3 free spins(rodadas gr\xE1tis)\r\n\nSempre
    que um ou mais Pig aparecerem eles ficam fixos nos espa\xE7os que pararam e n\xFAmero
    de free spins volta a ser igual a 3.\r\n\nQuando o n\xFAmero de free spins chega
    a zero, o PigSpin \xE9 encerrado e o valor pago \xE9 a quantidade de espa\xE7os
    com Pig vezes o seu valor de pagamento \r\n\nSe todos os espa\xE7os forem preenchidos
    com o Pig, o jogador ganha o jackpot desse mini game e o PigSpin \xE9 encerrado\r\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0161d805a3764c089bef00bfe00793f5, type: 2}
