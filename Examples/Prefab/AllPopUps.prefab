  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'CashBack is activated when the CoolPot bar is completely filled. Cool
    is the symbol that charges the bar.


    A new symbol, Money, is added to the
    reel, and the player receives a random number of free spins.


    For each Money
    symbol, the player receives a multiplier value that is accumulated. The values
    of the winning combinations from each free spin are also added up.


    When
    the number of free spins reaches zero, the CashBack feature ends, and the payout
    is the sum of the combination values multiplied by the sum of the multipliers.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0161d805a3764c089bef00bfe00793f5, type: 2}
  m_sharedMaterial: {fileID: 2147374, guid: 0161d805a3764c089bef00bfe00793f5, type: 2}
