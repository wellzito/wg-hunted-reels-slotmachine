  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "O CashBack \xE9 ativado quando a barra CoolPot \xE9 preenchida totalmente.
    Cool \xE9 o s\xEDmbolo que carrega a barra.\r\n\nUm novo s\xEDmbolo, Money, \xE9
    adicionado ao rodilho e o jogador recebe um n\xFAmero aleat\xF3rio de free spins.\r\n\nPara
    cada Money d\xE1 para o jogador um valor de multiplicador que vai sendo somado.
    O valores de combina\xE7\xF5es ganho em cada free spin tamb\xE9m v\xE3o sendo
    somados\r.\n\nQuando o n\xFAmero de free spins chega a zero, o CashBack \xE9
    encerrado e o valor pago \xE9 a quantidade das soma das combina\xE7\xF5es vezes
    a quantidade da soma dos multiplicadores.\r\n\n"
  m_isRightToLeft: 0
